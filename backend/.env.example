# SaveQuietly Phase 1 - Environment variables
# Copy to .env or .env.local and fill in values.

# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/savequietly?schema=public"

# JWT (required in production)
JWT_SECRET="your-super-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# CORS (optional; default allows all)
# CORS_ORIGIN="https://yourapp.com"
